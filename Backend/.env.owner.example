# Copy these settings into Backend/.env; supply your own values locally.
# Never put these credentials in frontend variables or commit Backend/.env.
SITE_OWNER_NAME=
SITE_OWNER_EMAIL=
SITE_OWNER_PHONE=
# At least 12 non-padding characters; at most 72 UTF-8 bytes (bcrypt limit).
# Quote values containing # in .env so dotenv preserves the whole password.
SITE_OWNER_PASSWORD=
